PORT=3000

# Secreto para firmar los tokens JWT. Generar uno propio, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-seguro

# Usuario administrador que se crea/actualiza automáticamente al arrancar
ADMIN_EMAIL=admin@teamacebal.com
ADMIN_PASSWORD=cambiar-por-una-clave-segura

# Orígenes permitidos para CORS, separados por coma. Vacío = acepta cualquiera
# (solo recomendado en desarrollo).
CORS_ORIGIN=http://localhost:5173
