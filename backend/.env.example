# PostgreSQL local, o DATABASE_URL provista por el hosting (Railway, Render, etc.)
NODE_ENV=development
PORT=3000

# En producción, usar DATABASE_URL y dejar estas variables sin completar.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=team_acebal

# Secreto para firmar los tokens JWT. Generar uno propio, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-seguro

# Usuario administrador que se crea/actualiza automáticamente al arrancar
ADMIN_EMAIL=admin@teamacebal.com
ADMIN_PASSWORD=cambiar-por-una-clave-segura

# Orígenes permitidos para CORS, separados por coma. Vacío = acepta cualquiera
# (solo recomendado en desarrollo).
CORS_ORIGIN=http://localhost:5173

# URLs públicas usadas para armar links (email de verificación y redirects).
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Resend (https://resend.com) para el email de verificación de cuentas nuevas.
# Sin API key, el registro funciona igual pero no se envía el mail (queda
# logueado en la consola del servidor).
RESEND_API_KEY=
# Dirección remitente. Sin verificar un dominio propio en Resend, "onboarding@resend.dev"
# solo puede enviar a la dirección con la que te registraste en Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev
